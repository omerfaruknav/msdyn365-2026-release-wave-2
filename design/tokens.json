{
  "meta": {
    "name": "BC 2026 wave 2, mapped",
    "note": "Unofficial, made by waldo. Contrast ratios are WCAG 2 relative luminance ratios. onBg = against color.bg, onSurface = against color.surface."
  },
  "font": {
    "ui": "'Schibsted Grotesk', 'Segoe UI', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, Menlo, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
  },
  "type": {
    "display": {"font": "ui", "size": 60, "weight": 800, "lineHeight": 0.95, "tracking": "-0.04em"},
    "displayMobile": {"font": "ui", "size": 34, "weight": 800, "lineHeight": 1, "tracking": "-0.03em"},
    "headline": {"font": "ui", "size": 24, "weight": 700, "lineHeight": 1.15, "tracking": "-0.02em"},
    "title": {"font": "ui", "size": 17, "weight": 700, "lineHeight": 1.25},
    "body": {"font": "ui", "size": 15, "weight": 400, "lineHeight": 1.5},
    "bodyLong": {"font": "ui", "size": 17, "weight": 400, "lineHeight": 1.6},
    "label": {"font": "ui", "size": 13, "weight": 500, "lineHeight": 1.2},
    "caption": {"font": "mono", "size": 12, "weight": 400, "lineHeight": 1.3},
    "eyebrow": {"font": "mono", "size": 11, "weight": 500, "transform": "uppercase", "tracking": "0.06em"},
    "monoChip": {"font": "mono", "size": 12, "weight": 700, "lineHeight": 1}
  },
  "color": {
    "light": {
      "bg": "#F2F6F7",
      "surface": "#FFFFFF",
      "text": {"value": "#0B2233", "onBg": 15.0, "onSurface": 16.3},
      "muted": {"value": "#496170", "onBg": 6.0, "onSurface": 6.5},
      "line": "#D2DEE3",
      "link": {"value": "#05509B", "onBg": 7.3, "onSurface": 8.0},
      "accent": {"value": "#0A7A6C", "onBg": 4.8, "onSurface": 5.2},
      "chip": {"bg": "#0B2233", "fg": "#BDF5D2", "contrast": 13.3},
      "onArea": "#FFFFFF"
    },
    "dark": {
      "bg": "#071620",
      "surface": "#0F2431",
      "text": {"value": "#E6F3F5", "onBg": 16.2, "onSurface": 14.0},
      "muted": {"value": "#93AEBB", "onBg": 7.9, "onSurface": 6.8},
      "line": "#21404F",
      "link": {"value": "#6FD8F0", "onBg": 11.1, "onSurface": 9.7},
      "accent": {"value": "#7BEFD2", "onBg": 13.2, "onSurface": 11.5},
      "chip": {"bg": "#7BEFD2", "fg": "#071620", "contrast": 13.2},
      "onArea": "#071620"
    }
  },
  "area": {
    "note": "light.label = contrast of white (#FFFFFF) text on the fill. dark.label = contrast of #071620 text on the fill. Ring order clockwise from 12 o'clock is the array order; it keeps similar hues apart and puts the three smallest areas on the left side where labels stack vertically.",
    "order": ["developer-tools", "expense-agent", "supply-chain", "reporting-and-analytics", "integration", "sustainability", "e-documents", "finance", "admin-and-platform", "copilot-and-agents"],
    "developer-tools": {"light": "#05509B", "lightLabel": 8.0, "dark": "#5B9DF0", "darkLabel": 6.6},
    "expense-agent": {"light": "#C74A12", "lightLabel": 4.8, "dark": "#FF8A5C", "darkLabel": 7.9},
    "supply-chain": {"light": "#1F6DBD", "lightLabel": 5.3, "dark": "#7CC6F5", "darkLabel": 9.8},
    "reporting-and-analytics": {"light": "#B62C84", "lightLabel": 5.7, "dark": "#F06CB8", "darkLabel": 6.6},
    "integration": {"light": "#087F86", "lightLabel": 4.8, "dark": "#2ED9CF", "darkLabel": 10.4},
    "sustainability": {"light": "#4F7F12", "lightLabel": 4.8, "dark": "#9BD148", "darkLabel": 10.1},
    "e-documents": {"light": "#96690A", "lightLabel": 4.9, "dark": "#E0A63A", "darkLabel": 8.5},
    "finance": {"light": "#0B7F5C", "lightLabel": 5.0, "dark": "#2FCB9E", "darkLabel": 8.9},
    "admin-and-platform": {"light": "#566B78", "lightLabel": 5.6, "dark": "#A9BCC7", "darkLabel": 9.4},
    "copilot-and-agents": {"light": "#6D45D0", "lightLabel": 6.2, "dark": "#A98BF5", "darkLabel": 6.7}
  },
  "status": {
    "note": "Status never uses hue. It is a fill treatment stacked on the area color (c).",
    "ga": {"fill": "c", "label": "GA"},
    "preview": {"fill": "c", "overlay": "45 degree hatch in color.bg, 7px period, 2.2px stroke", "glyph": "repeating-linear-gradient(45deg, c 0 3px, surface 3px 5px) + 1.5px outline in c", "label": "Preview"},
    "announced": {"fill": "color.bg", "stroke": "c, 1.5px, dash 5 3", "label": "Announced"},
    "unclear": {"fill": "color-mix(in srgb, c 46%, color.bg)", "label": "Unclear"},
    "slot": {"fill": "color-mix(in srgb, c 24%, color.bg)", "note": "placeholder for a feature not extracted yet; prototype only"},
    "ghost": {"fill": "transparent", "stroke": "color.muted, 1px, dash 3 3", "note": "video without features or transcript"}
  },
  "devRelevance": {"high": "outer tick arc, color.text at 60% opacity, radius 0.972R to 1.0R", "medium": "no marker", "low": "no marker"},
  "map": {
    "radii": {"note": "fractions of R, the outer radius of the drawing", "center": 0.40, "ring1": [0.44, 0.66], "ring2": [0.675, 0.955], "devTick": [0.972, 1.0]},
    "labelMargin": {"S>=640": 100, "S<640": 84},
    "nodeStroke": {"color": "color.bg", "width": 1.4, "widthUnder1.2deg": 0.6, "linejoin": "round"},
    "dimOpacity": 0.13,
    "unselectedOpacity": 0.4,
    "featureLabelMinAngle": 8
  },
  "radius": {"chip": 6, "pill": 17, "card": 12, "panel": 16, "sheet": 20},
  "space": {"unit": 4, "gutter": 20, "panelDesktop": 400, "panelTablet": 340, "leftColumn": 280, "topbar": 56},
  "motion": {
    "zoom": {"duration": 450, "easing": "cubic-bezier(.2,.8,.2,1)"},
    "hover": {"duration": 120, "easing": "ease-out"},
    "filterDim": {"duration": 180, "easing": "ease-out"},
    "panelOpen": {"duration": 220, "easing": "ease-out", "from": "translateY(24px), opacity 0"},
    "panelClose": {"duration": 160, "easing": "ease-in"},
    "sheetOpen": {"duration": 240, "easing": "ease-out"},
    "reducedMotion": "all durations 0, zoom becomes a cut"
  },
  "breakpoints": {"desktop": 1200, "tablet": 700, "mobile": 0}
}
